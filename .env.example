# Copia este archivo a .env.local y rellena los valores.
# Ver README.md → "Variables de entorno" para la tabla completa de qué se
# rompe (o se degrada con gracia) si falta cada grupo.

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (requerido — sin esto la app entera no funciona) -------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Taps NFC ---------------------------------------------------------------
# Cualquier cadena secreta — salt para el hash de IP de los taps.
# Sin esto usa un secreto de desarrollo hardcodeado (lib/tracking.ts).
IP_HASH_SECRET=

# --- Correo (Resend) --------------------------------------------------------
# Sin esto, /demo y las alertas por correo se saltan el envío con gracia.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SALES_INBOX_EMAIL=

# --- Stripe ------------------------------------------------------------------
# Sin esto, /app/facturacion muestra "Stripe no está configurado" y el
# webhook responde 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Web Push ----------------------------------------------------------------
# Genera el par de llaves con: npx web-push generate-vapid-keys
# NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY y WEB_PUSH_PUBLIC_KEY deben tener el MISMO valor.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# --- WhatsApp (Cloud API) -----------------------------------------------------
# Sin esto, el envío se salta con gracia (lib/notify.ts).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# --- Reportes programados ------------------------------------------------------
# Usado por /api/cron/reports para validar el header Authorization: Bearer.
CRON_SECRET=

# --- IA (preparado — Fase 4 no lo usa; TAP Intelligence hoy es por reglas) ----
# Ver docs/architecture.md §11.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
